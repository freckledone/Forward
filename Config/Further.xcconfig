// Build identity for Further.
//
// The defaults below are placeholders, so this repository carries no personal
// Apple Developer identifiers. As-is they are enough to build and run in the
// Simulator.
//
// To build on a device, sync with iCloud, or write to Apple Health, copy
// Config/Local.xcconfig.example to Config/Local.xcconfig and put your own
// values in it. That file is git-ignored, so your identifiers stay on your
// machine.

// Your Apple Developer Team ID (Membership page in the developer portal).
// Empty means "no team": the Simulator builds, device builds won't sign.
FURTHER_TEAM_ID =

// Reverse-DNS bundle identifier. Must be unique to you.
FURTHER_BUNDLE_ID = com.example.Further

// CloudKit container. Apple's convention is "iCloud." + your bundle id, and it
// must match the container you provision in Signing & Capabilities.
FURTHER_ICLOUD_CONTAINER = iCloud.com.example.Further

// Included AFTER the defaults so it overrides them — in an xcconfig the last
// assignment wins, so an include placed above would be silently discarded.
#include? "Local.xcconfig"

DEVELOPMENT_TEAM = $(FURTHER_TEAM_ID)
